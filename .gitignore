experiments/*.json

# Upstream template archive; the extracted neurips_2026.sty is tracked instead.
Formatting_Instructions_For_NeurIPS_2026.zip

# Submission bundle, rebuilt from the tracked sources.
paper/supplementary.zip
# ...except the recorded results behind the paper's figures and numbers, so that
# `make figures` works from a fresh clone.
!experiments/reparam_invariance_results.json
!experiments/containment_audit_results_v2.json
!experiments/center_validity_results.json

# OpenReview reviews and decision are restricted to Program Chairs, Reviewers and
# Authors, so they are kept locally and not published with the repository.
reviews.html
review/

# Local download of the OpenReview PDF; byte-identical to the tracked
# paper/main_full9_revised.pdf (see paper/ERRATA.md for the checksum).
9_Calibrating_What_Behavior_Ca.pdf
